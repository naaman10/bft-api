# Server
PORT=4000
NODE_ENV=development

# Comma-separated origins allowed by CORS (Learn app, then admin app when it exists)
FRONTEND_URL=http://localhost:3000

# Shared secret for admin endpoints. Generate with: openssl rand -base64 32
ADMIN_API_KEY=

# Neon Auth — copy from Console → Auth → Configuration (same value as bft-learn)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# Optional. Defaults to {NEON_AUTH_BASE_URL}/.well-known/jwks.json
NEON_AUTH_JWKS_URL=

# Neon Management API — Console → Account settings → API keys
NEON_API_KEY=napi_hu0n5d1r6d1sbxf7819hy3nzfkankf6o4gl7ani3gosle1wjm7bjb7rsr6zk91pt
NEON_PROJECT_ID=mute-hall-33379341
NEON_BRANCH_ID=br-floral-flower-abzn6lc9

# Learn app origin used as the magic-link callback (must be a trusted Auth domain)
LEARN_APP_URL=http://localhost:3000

# Neon Database — pooled connection string from Console → Dashboard
# Required for /admin/user/create (stores neon_user_id on students)
DATABASE_URL=

# Contentful Delivery API
CONTENTFUL_SPACE_ID=h9pen7p8e4c2
CONTENTFUL_ACCESS_TOKEN=_HuK3brUjJ2Qb-NCPDXH6FZB8xhq5vu06hzsJEkLKC4
CONTENTFUL_ENVIRONMENT=master

# Resend — API Keys in the Resend dashboard. For local tests use onboarding@resend.dev
RESEND_API_KEY=
RESEND_FROM_EMAIL=BFT Learn <onboarding@resend.dev>
